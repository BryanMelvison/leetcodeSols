class Solution:
    def evaluate(self, s: str, knowledge: list[list[str]]) -> str:
        # For ( bracket sign: whatever is inside, append,
            # If found another bracket sign, current bit is appended first
        # if ) is found, pop the stack, and append the reversed bit, and append
        # Time complexity, O(n) : Just one for loop
        # Space complexity, O(n) : store at most n elements in the stack
        # Performance:
        # Runtime: faster than 69.25%
        # Memory Usage: beats 13.43%.

        kb = {}
        for know in knowledge:
            kb[know[0]] = know[1]
        
        current = ""
        stack = []
        for c in s:
            if c == "(":
                stack.append(current)
                current = ""
            elif c == ")":
                if current in kb:
                    current = kb[current]
                else:
                    current = "?"
                stack.append(current)
                current = ""
            else:
                current += c
        
        return "".join(stack) + current